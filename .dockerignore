# Docker ignore file for Java Maven projects
# Exclude build artifacts, IDE files, and wrapper scripts

# Maven build artifacts
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Maven wrapper (CRITICAL: Never copy wrapper files to Docker)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper (CRITICAL: Never copy wrapper files to Docker)
gradlew
gradlew.bat
gradle/wrapper/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.metadata/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/

# Logs
logs/
*.log

# Test coverage
.coverage
htmlcov/
coverage/

# Environment files
.env
.env.local
.env.*.local

# Docker files (don't copy Docker files into Docker)
Dockerfile
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile

# Temporary files
tmp/
temp/
*.tmp
