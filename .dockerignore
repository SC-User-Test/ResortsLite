# ── Compiled output ──────────────────────────────────────────
target/
build/
out/

# ── Maven wrapper (NEVER used inside Docker) ─────────────────
mvnw
mvnw.cmd
.mvn/

# ── Gradle wrapper (NEVER used inside Docker) ────────────────
gradlew
gradlew.bat
gradle/wrapper/
.gradle/

# ── Version control ──────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── IDE / editor files ───────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
*.swp
*.swo

# ── OS artefacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Documentation ────────────────────────────────────────────
*.md
docs/

# ── Docker files (not needed in build context) ───────────────
docker-compose*.yml
Dockerfile*
.dockerignore

# ── Test reports ─────────────────────────────────────────────
**/surefire-reports/
**/failsafe-reports/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Scripts (not needed in image) ────────────────────────────
scripts/

# ── Temporary files ──────────────────────────────────────────
*.tmp
*.bak
*.orig
